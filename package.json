{
  "name": "@adviverse/extension",
  "version": "0.1.0",
  "description": "Adviverse ads on your browser extension's own pages (popup, options, new tab, side panel). Manifest V3-safe: no remote code, no permissions.",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/Adviverse/extension.git" },
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": { "types": "./index.d.ts", "default": "./index.js" },
    "./package.json": "./package.json"
  },
  "files": ["index.js", "index.d.ts", "README.md"],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "keywords": ["adviverse", "ads", "chrome-extension", "browser-extension", "manifest-v3", "firefox", "edge"]
}
